<Page x:Class="PulseGuard.Views.Pages.OptimizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="640"
      d:DesignWidth="900"
      Title="{DynamicResource Loc.Opt.Title}">

    <ui:DynamicScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        PanningMode="VerticalOnly">
        <StackPanel Margin="20,20,20,24">
            <!-- Header -->
            <TextBlock
                Margin="0,0,0,16"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                Text="{DynamicResource Loc.Opt.Title}" />

            <!-- Card 1: Safe RAM Cleaner -->
            <ui:Card Margin="0,0,0,14" Padding="20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon
                                    Margin="0,0,10,0"
                                    FontSize="22"
                                    Foreground="#00E5A0"
                                    Symbol="Memory16" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource Loc.Opt.RamTitle}" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                Text="{Binding ViewModel.RamStatusText}" />

                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding ViewModel.RamActionStatus}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ui:Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Appearance="Primary"
                            Command="{Binding ViewModel.CleanRamCommand}"
                            Content="{DynamicResource Loc.Opt.FreeRam}"
                            Icon="{ui:SymbolIcon Broom24}"
                            IsEnabled="{Binding ViewModel.CanCleanRam}"
                            Padding="16,10" />
                    </Grid>

                    <Border Height="1" Margin="0,14,0,12" Background="#1FFFFFFF" />

                    <ui:ToggleSwitch
                        Margin="0,0,0,10"
                        Content="{DynamicResource Loc.Opt.AutoRamToggle}"
                        IsChecked="{Binding ViewModel.IsAutoRamCleanEnabled, Mode=TwoWay}" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#00E5A0"
                                    Text="{Binding ViewModel.AutoRamCleanThresholdPercent, StringFormat='{}{0:0} %'}" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource Loc.Opt.AutoRamThreshold}" />
                            </DockPanel>
                            <Slider
                                Margin="0,4,0,0"
                                IsSnapToTickEnabled="True"
                                Maximum="95"
                                Minimum="65"
                                TickFrequency="1"
                                Value="{Binding ViewModel.AutoRamCleanThresholdPercent, Mode=TwoWay}" />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DisplayMemberPath="DisplayText"
                            ItemsSource="{Binding ViewModel.AutoCleanIntervalOptions}"
                            SelectedItem="{Binding ViewModel.SelectedAutoCleanIntervalOption, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock
                        FontSize="12"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding ViewModel.AutoRamCleanStatus}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!-- Card 2: Temporary Files & Cache Cleaner -->
            <ui:Card Margin="0,0,0,14" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <ui:Button
                                Margin="0,0,8,0"
                                Command="{Binding ViewModel.AnalyzeTempCommand}"
                                Content="{DynamicResource Loc.Opt.Analyze}"
                                Icon="{ui:SymbolIcon Search24}"
                                IsEnabled="{Binding ViewModel.CanAnalyzeTemp}"
                                Padding="14,8" />
                            <ui:Button
                                Appearance="Primary"
                                Command="{Binding ViewModel.CleanTempCommand}"
                                Content="{DynamicResource Loc.Opt.CleanSelected}"
                                Icon="{ui:SymbolIcon Delete24}"
                                IsEnabled="{Binding ViewModel.CanCleanTemp}"
                                Padding="14,8" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                Margin="0,0,10,0"
                                FontSize="22"
                                Foreground="#00B2FF"
                                Symbol="Folder24" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                Text="{DynamicResource Loc.Opt.TempTitle}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,6"
                            Content="{DynamicResource Loc.Opt.UserTemp}"
                            IsChecked="{Binding ViewModel.IncludeUserTemp, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="16,0,0,6"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ViewModel.UserTempInfo}" />

                        <CheckBox
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,6"
                            Content="{DynamicResource Loc.Opt.WinTemp}"
                            IsChecked="{Binding ViewModel.IncludeSystemTemp, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="16,0,0,6"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ViewModel.SystemTempInfo}" />

                        <CheckBox
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,0,6"
                            Content="{DynamicResource Loc.Opt.D3dCache}"
                            IsChecked="{Binding ViewModel.IncludeD3dShaderCache, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="16,0,0,6"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ViewModel.D3dShaderCacheInfo}" />

                        <CheckBox
                            Grid.Row="3"
                            Grid.Column="0"
                            Content="{DynamicResource Loc.Opt.RecycleBin}"
                            IsChecked="{Binding ViewModel.IncludeRecycleBin, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ViewModel.RecycleBinInfo}" />
                    </Grid>

                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding ViewModel.TempActionStatus}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!-- Card 3: Internet & DNS Optimization -->
            <ui:Card Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Command="{Binding ViewModel.DiagnoseNetworkCommand}"
                                Content="{DynamicResource Loc.Opt.CheckDns}"
                                Icon="{ui:SymbolIcon Search24}"
                                IsEnabled="{Binding ViewModel.CanRunNetworkAction}"
                                Padding="12,8" />
                            <ui:Button
                                Appearance="Primary"
                                Command="{Binding ViewModel.OptimizeNetworkCommand}"
                                Content="{DynamicResource Loc.Opt.SpeedUpNet}"
                                Icon="{ui:SymbolIcon Flash24}"
                                IsEnabled="{Binding ViewModel.CanRunNetworkAction}"
                                Padding="14,8" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                Margin="0,0,10,0"
                                FontSize="22"
                                Foreground="#38BDF8"
                                Symbol="Globe24" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                Text="{DynamicResource Loc.Opt.NetTitle}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="{Binding ViewModel.NetworkAdapterInfo}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="12"
                        Foreground="#00E5A0"
                        Text="{Binding ViewModel.NetworkBenchmarkSummary}"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            Command="{Binding ViewModel.FlushDnsCommand}"
                            Content="{DynamicResource Loc.Opt.FlushDns}"
                            IsEnabled="{Binding ViewModel.CanRunNetworkAction}"
                            Padding="10,6" />
                        <ui:Button
                            Appearance="Secondary"
                            Command="{Binding ViewModel.ResetDnsToDhcpCommand}"
                            Content="{DynamicResource Loc.Opt.ResetDns}"
                            IsEnabled="{Binding ViewModel.CanRunNetworkAction}"
                            Padding="10,6" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding ViewModel.NetworkActionStatus}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ui:DynamicScrollViewer>
</Page>
