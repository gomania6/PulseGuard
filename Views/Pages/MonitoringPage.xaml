<Page x:Class="PulseGuard.Views.Pages.MonitoringPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="640"
      d:DesignWidth="900"
      Title="Мониторинг">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <ui:DynamicScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        PanningMode="VerticalOnly">
        <Grid Margin="20,20,20,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,16"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                Text="{Binding ViewModel.Title}" />

            <!-- 4 Metric Cards -->
            <UniformGrid Grid.Row="1" Columns="4">
                <!-- CPU Card -->
                <ui:Card
                    Margin="0,0,8,0"
                    Padding="16"
                    VerticalAlignment="Stretch"
                    ToolTip="{Binding ViewModel.CpuCardTooltip}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <ui:SymbolIcon
                                DockPanel.Dock="Right"
                                FontSize="20"
                                Foreground="#00B2FF"
                                Symbol="DeveloperBoard24" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="CPU" />
                        </DockPanel>
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                            Text="{Binding ViewModel.CpuLoadText}" />
                        <ProgressBar
                            Height="6"
                            Margin="0,8,0,10"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding ViewModel.CpuLoadPercent}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding ViewModel.CpuTempText, StringFormat='Температура: {0}'}"
                                ToolTip="{Binding ViewModel.CpuTempTooltip}" />
                            <ui:Button
                                Margin="6,0,0,0"
                                Padding="5,1"
                                Command="{Binding ViewModel.ShowDriverHelpCommand}"
                                Content="?"
                                FontSize="11"
                                ToolTip="Как включить датчики температуры?"
                                Visibility="{Binding ViewModel.IsCpuTempBlocked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ViewModel.CpuClockText, StringFormat='Частота: {0}'}" />
                    </StackPanel>
                </ui:Card>

                <!-- GPU Card -->
                <ui:Card Margin="4,0,4,0" Padding="16" VerticalAlignment="Stretch">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <ui:SymbolIcon
                                DockPanel.Dock="Right"
                                FontSize="20"
                                Foreground="#00E5A0"
                                Symbol="Desktop24" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="GPU" />
                        </DockPanel>
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                            Text="{Binding ViewModel.GpuLoadText}" />
                        <ProgressBar
                            Height="6"
                            Margin="0,8,0,10"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding ViewModel.GpuLoadPercent}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ViewModel.GpuTempText, StringFormat='Температура: {0}'}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ViewModel.GpuVramText}" />
                    </StackPanel>
                </ui:Card>

                <!-- RAM Card -->
                <ui:Card Margin="4,0,4,0" Padding="16" VerticalAlignment="Stretch">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <ui:SymbolIcon
                                DockPanel.Dock="Right"
                                FontSize="20"
                                Foreground="#B388FF"
                                Symbol="Memory16" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="ОЗУ (RAM)" />
                        </DockPanel>
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                            Text="{Binding ViewModel.RamLoadText}" />
                        <ProgressBar
                            Height="6"
                            Margin="0,8,0,10"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding ViewModel.RamLoadPercent}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ViewModel.RamUsageText, StringFormat='Занято: {0}'}" />
                    </StackPanel>
                </ui:Card>

                <!-- Network Card -->
                <ui:Card Margin="8,0,0,0" Padding="16" VerticalAlignment="Stretch">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <ui:SymbolIcon
                                DockPanel.Dock="Right"
                                FontSize="20"
                                Foreground="#FFA600"
                                Symbol="Globe24" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="Сеть" />
                        </DockPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="Скачивание (Download)" />
                        <TextBlock
                            Margin="0,2,0,8"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#7C5CFF"
                            Text="{Binding ViewModel.NetworkDownloadText}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="Отдача (Upload)" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#FFA600"
                            Text="{Binding ViewModel.NetworkUploadText}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Loss" />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding ViewModel.NetworkQualityBrush}"
                                    Text="{Binding ViewModel.NetworkPacketLossText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Jitter" />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding ViewModel.NetworkQualityBrush}"
                                    Text="{Binding ViewModel.NetworkJitterText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!-- Network Lag Radar (Top-3 Consumers) -->
            <ui:Card Grid.Row="3" Margin="0,12,0,0" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="Безопасная заморозка (NtSuspendProcess) с авто-разморозкой при выходе" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="18"
                                Foreground="#7C5CFF"
                                Symbol="CellularData124" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Сетевой радар лагов (Топ-3 потребителя)" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock
                        FontSize="12"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="Активный сетевой трафик пользовательских процессов не обнаружен."
                        Visibility="{Binding ViewModel.HasNoTopNetworkProcesses, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ItemsControl
                        ItemsSource="{Binding ViewModel.TopNetworkProcesses}"
                        Visibility="{Binding ViewModel.HasTopNetworkProcesses, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,4" ToolTip="{Binding TooltipText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Source="{Binding Icon}"
                                        Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:SymbolIcon
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                        Symbol="AppGeneric20"
                                        Visibility="{Binding HasNoIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Text="{Binding ProcessName}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#7C5CFF"
                                        Text="{Binding DownloadText}" />

                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Foreground="#FFA600"
                                        Text="{Binding UploadText}" />

                                    <ui:Button
                                        Grid.Column="4"
                                        Padding="10,4"
                                        Appearance="Secondary"
                                        Command="{Binding ToggleSuspendCommand}"
                                        Content="{Binding ActionButtonText}"
                                        FontSize="11"
                                        IsEnabled="{Binding CanToggleSuspend}"
                                        ToolTip="{Binding ActionTooltip}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="{Binding ActionButtonIcon}" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!-- Battery Devices Card -->
            <ui:Card Grid.Row="4" Margin="0,12,0,0" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button
                                Margin="0,0,6,0"
                                Appearance="Transparent"
                                Command="{Binding ViewModel.ExportHidDiagnosticsCommand}"
                                Content="Поиск HID"
                                FontSize="12"
                                Icon="{ui:SymbolIcon Search20}"
                                Padding="8,4"
                                ToolTip="Сохранить список всех USB HID-устройств в %AppData%\PulseGuard\hid_devices.txt" />
                            <ui:Button
                                Command="{Binding ViewModel.RefreshBatteryDevicesCommand}"
                                Content="Обновить"
                                Icon="{ui:SymbolIcon ArrowSync20}"
                                Padding="10,4" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="18"
                                Foreground="#00E5A0"
                                Symbol="Battery520" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Заряд устройств" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock
                        FontSize="12"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="Беспроводные и PnP-устройства с датчиком заряда не найдены."
                        Visibility="{Binding ViewModel.HasNoBatteryDevices, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ItemsControl ItemsSource="{Binding ViewModel.BatteryDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,4" Opacity="{Binding ItemOpacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{Binding AccentBrush}"
                                        Symbol="{Binding DeviceIcon}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding StatusText}" />
                                    </StackPanel>

                                    <ProgressBar
                                        Grid.Column="2"
                                        Height="6"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding AccentBrush}"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="{Binding BatteryPercent, Mode=OneWay}" />

                                    <TextBlock
                                        Grid.Column="3"
                                        Margin="10,0,10,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding AccentBrush}"
                                        Text="{Binding BatteryPercentText}" />

                                    <ui:ToggleSwitch
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Content="В оверлей"
                                        IsChecked="{Binding IsPinnedToOverlay, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!-- Real-time Charts (Last 60 Seconds) -->
            <Grid Grid.Row="5" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Padding="16">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Загрузка CPU и GPU (60 сек)" />
                        <lvc:CartesianChart
                            Height="210"
                            AnimationsSpeed="00:00:00"
                            Background="Transparent"
                            DrawMarginFrame="{Binding ViewModel.ChartDrawMarginFrame}"
                            EasingFunction="{x:Null}"
                            LegendTextPaint="{Binding ViewModel.ChartLegendTextPaint}"
                            Series="{Binding ViewModel.CpuGpuSeries}"
                            TooltipBackgroundPaint="{Binding ViewModel.ChartTooltipBackgroundPaint}"
                            TooltipTextPaint="{Binding ViewModel.ChartTooltipTextPaint}"
                            XAxes="{Binding ViewModel.HiddenXAxes}"
                            YAxes="{Binding ViewModel.CpuGpuYAxes}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="2" Padding="16">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Сетевой трафик, Мбит/с (60 сек)" />
                        <lvc:CartesianChart
                            Height="210"
                            AnimationsSpeed="00:00:00"
                            Background="Transparent"
                            DrawMarginFrame="{Binding ViewModel.ChartDrawMarginFrame}"
                            EasingFunction="{x:Null}"
                            LegendTextPaint="{Binding ViewModel.ChartLegendTextPaint}"
                            Series="{Binding ViewModel.NetworkSeries}"
                            TooltipBackgroundPaint="{Binding ViewModel.ChartTooltipBackgroundPaint}"
                            TooltipTextPaint="{Binding ViewModel.ChartTooltipTextPaint}"
                            XAxes="{Binding ViewModel.HiddenXAxes}"
                            YAxes="{Binding ViewModel.NetworkYAxes}" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Stutter / Latency Stability Card -->
            <ui:Card Grid.Row="6" Margin="0,12,0,0" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Margin="0,0,10,0"
                            FontSize="20"
                            Foreground="{Binding ViewModel.StutterStabilityBrush}"
                            Symbol="Pulse24" />
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="Стабильность / Фризы за сессию" />
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{Binding ViewModel.StutterStabilityBrush}"
                                Text="{Binding ViewModel.StutterCountText}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                            Text="{Binding ViewModel.StutterMaxDelayText}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ViewModel.StutterDetailsText}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Peak Alerts Log -->
            <ui:Card Grid.Row="7" Margin="0,12,0,0" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button
                            Command="{Binding ViewModel.ClearAlertsCommand}"
                            Content="Очистить"
                            DockPanel.Dock="Right"
                            Padding="10,4" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="18"
                                Foreground="#FF6B6B"
                                Symbol="Warning24" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Лог пиков (CPU/GPU &gt; 85°C, ОЗУ &gt; 90%)" />
                        </StackPanel>
                    </DockPanel>

                    <ListBox
                        MaxHeight="130"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding ViewModel.AlertLogs}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#FF9E9E"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ui:Card>
        </Grid>
    </ui:DynamicScrollViewer>
</Page>
