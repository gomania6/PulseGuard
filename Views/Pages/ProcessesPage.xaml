<Page x:Class="PulseGuard.Views.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="640"
      d:DesignWidth="900"
      Title="Процессы">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SortableHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock
                DockPanel.Dock="Right"
                VerticalAlignment="Bottom"
                FontSize="12"
                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.ProcessCountText}" />
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                Text="{Binding ViewModel.Title}" />
        </DockPanel>

        <!-- Top Resource-Consuming Applications -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                Text="Топ нагружающих приложений" />

            <UniformGrid Columns="3">
                <!-- CPU Leader -->
                <ui:Card Margin="0,0,6,0" Padding="14,12">
                    <DockPanel>
                        <ui:SymbolIcon
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            FontSize="22"
                            Foreground="#00B2FF"
                            Symbol="DeveloperBoard24" />
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="Лидер по CPU" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                Text="{Binding ViewModel.TopCpuName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="#00B2FF"
                                Text="{Binding ViewModel.TopCpuValue}" />
                        </StackPanel>
                    </DockPanel>
                </ui:Card>

                <!-- RAM Leader -->
                <ui:Card Margin="3,0,3,0" Padding="14,12">
                    <DockPanel>
                        <ui:SymbolIcon
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            FontSize="22"
                            Foreground="#00E5A0"
                            Symbol="Memory16" />
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="Лидер по ОЗУ" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                Text="{Binding ViewModel.TopRamName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="#00E5A0"
                                Text="{Binding ViewModel.TopRamValue}" />
                        </StackPanel>
                    </DockPanel>
                </ui:Card>

                <!-- Disk Leader -->
                <ui:Card Margin="6,0,0,0" Padding="14,12">
                    <DockPanel>
                        <ui:SymbolIcon
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            FontSize="22"
                            Foreground="#FFB900"
                            Symbol="HardDrive20" />
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="Лидер по Диску" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                Text="{Binding ViewModel.TopDiskName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="#FFB900"
                                Text="{Binding ViewModel.TopDiskValue}" />
                        </StackPanel>
                    </DockPanel>
                </ui:Card>
            </UniformGrid>
        </StackPanel>

        <!-- Search & Filter Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox
                Grid.Column="0"
                Margin="0,0,16,0"
                ClearButtonEnabled="True"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="Поиск по названию процесса..."
                Text="{Binding ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ui:ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="Скрыть системные процессы"
                IsChecked="{Binding ViewModel.HideSystemProcesses, Mode=TwoWay}" />
        </Grid>

        <!-- Virtualized Processes ListView -->
        <ui:Card Grid.Row="3" Padding="0" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Headers -->
                <Border
                    Grid.Row="0"
                    Padding="12,9"
                    Background="#12FFFFFF"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.3*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Command="{Binding ViewModel.SortByCommand}"
                            CommandParameter="Name"
                            Style="{StaticResource SortableHeaderButtonStyle}">
                            <TextBlock Text="{Binding ViewModel.NameSortGlyph, StringFormat='Приложение{0}'}" />
                        </Button>

                        <Button
                            Grid.Column="1"
                            Command="{Binding ViewModel.SortByCommand}"
                            CommandParameter="Cpu"
                            Style="{StaticResource SortableHeaderButtonStyle}">
                            <TextBlock Text="{Binding ViewModel.CpuSortGlyph, StringFormat='CPU (%){0}'}" />
                        </Button>

                        <Button
                            Grid.Column="2"
                            Command="{Binding ViewModel.SortByCommand}"
                            CommandParameter="Memory"
                            Style="{StaticResource SortableHeaderButtonStyle}">
                            <TextBlock Text="{Binding ViewModel.MemorySortGlyph, StringFormat='ОЗУ (МБ){0}'}" />
                        </Button>

                        <Button
                            Grid.Column="3"
                            Command="{Binding ViewModel.SortByCommand}"
                            CommandParameter="Disk"
                            Style="{StaticResource SortableHeaderButtonStyle}">
                            <TextBlock Text="{Binding ViewModel.DiskSortGlyph, StringFormat='Диск (МБ/с){0}'}" />
                        </Button>

                        <Button
                            Grid.Column="4"
                            Command="{Binding ViewModel.SortByCommand}"
                            CommandParameter="Priority"
                            Style="{StaticResource SortableHeaderButtonStyle}">
                            <TextBlock Text="{Binding ViewModel.PrioritySortGlyph, StringFormat='Приоритет{0}'}" />
                        </Button>

                        <TextBlock
                            Grid.Column="5"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="Действия" />
                    </Grid>
                </Border>

                <!-- Virtualized ListView (Recycling, Fixed Row Height) -->
                <ListView
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding ViewModel.VisibleProcesses}"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding ViewModel.SelectedProcess, Mode=TwoWay}"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Height" Value="38" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="#14FFFFFF" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border
                                            Height="{TemplateBinding Height}"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0EFFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1EFFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.3*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <!-- Application Group Name -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon
                                        Margin="0,0,8,0"
                                        FontSize="14"
                                        Foreground="#FFB900"
                                        Symbol="ShieldCheckmark24"
                                        ToolTip="Защищённый системный процесс Windows"
                                        Visibility="{Binding IsSystemProtected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        FontWeight="Medium"
                                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- CPU (%) -->
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{Binding CpuText}" />

                                <!-- RAM (MB) -->
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{Binding MemoryText}" />

                                <!-- Disk (MB/s) -->
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{Binding DiskText}" />

                                <!-- Priority -->
                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding PriorityText}" />

                                <!-- Safe Group Actions -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button
                                        Margin="0,0,6,0"
                                        Padding="6,4"
                                        Command="{Binding DataContext.ViewModel.TogglePriorityCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanModify}"
                                        ToolTip="{Binding PriorityActionTooltip}"
                                        ToolTipService.ShowOnDisabled="True">
                                        <ui:SymbolIcon FontSize="15" Symbol="ArrowDown24" />
                                    </ui:Button>
                                    <ui:Button
                                        Padding="6,4"
                                        Command="{Binding DataContext.ViewModel.TrimWorkingSetCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanModify}"
                                        ToolTip="{Binding TrimRamTooltip}"
                                        ToolTipService.ShowOnDisabled="True">
                                        <ui:SymbolIcon FontSize="15" Symbol="Broom24" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </ui:Card>

        <!-- Action Feedback Footer -->
        <TextBlock
            Grid.Row="4"
            Margin="0,10,0,0"
            FontSize="12"
            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
            Text="{Binding ViewModel.ActionStatusText}" />
    </Grid>
</Page>
