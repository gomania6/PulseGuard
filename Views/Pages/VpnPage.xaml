<Page x:Class="PulseGuard.Views.Pages.VpnPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="640"
      d:DesignWidth="900"
      Title="VPN">

    <ui:DynamicScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        PanningMode="VerticalOnly">
        <StackPanel Margin="20,20,20,24">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                Text="{Binding ViewModel.Title}" />

            <!-- Main VPN Status & Controls -->
            <ui:Card Margin="0,0,0,14" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                Margin="0,0,12,0"
                                FontSize="26"
                                Foreground="#00B2FF"
                                Symbol="Shield24" />
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Состояние подключения" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <Ellipse
                                        Width="10"
                                        Height="10"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Fill="{Binding ViewModel.StatusBrush}" />
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{Binding ViewModel.StatusText}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                Command="{Binding ViewModel.ToggleVpnCommand}"
                                Content="{Binding ViewModel.ToggleButtonText}"
                                IsEnabled="{Binding ViewModel.CanControlVpn}"
                                Padding="16,10" />
                            <ui:Button
                                Command="{Binding ViewModel.RestartVpnCommand}"
                                Content="Перезапустить"
                                Icon="{ui:SymbolIcon ArrowSync20}"
                                IsEnabled="{Binding ViewModel.CanControlVpn}"
                                Padding="14,10" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Margin="0,0,0,14" Background="#1FFFFFFF" />

                    <!-- All VPN Metrics Grid -->
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Border Margin="0,0,8,8" Padding="12" Background="#14FFFFFF" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="Сервер" />
                                <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Text="{Binding ViewModel.ServerText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,8,8" Padding="12" Background="#14FFFFFF" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="Внешний IP" />
                                <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Text="{Binding ViewModel.ExternalIpText}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,8,8" Padding="12" Background="#14FFFFFF" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="Пинг (1.1.1.1)" />
                                <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Text="{Binding ViewModel.PingText}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,8" Padding="12" Background="#14FFFFFF" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="Качество канала" />
                                <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{Binding ViewModel.QualityBrush}" Text="{Binding ViewModel.QualityText}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <UniformGrid Columns="4">
                        <Border Margin="0,0,8,0" Padding="12" Background="#14FFFFFF" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="Потери пакетов (Loss)" />
                                <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{Binding ViewModel.QualityBrush}" Text="{Binding ViewModel.PacketLossText}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,8,0" Padding="12" Background="#14FFFFFF" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="Джиттер (Jitter)" />
                                <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{Binding ViewModel.QualityBrush}" Text="{Binding ViewModel.JitterText}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,8,0" Padding="12" Background="#14FFFFFF" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="Процесс клиента" />
                                <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Text="{Binding ViewModel.ProcessStateText}" />
                            </StackPanel>
                        </Border>

                        <Border Padding="12" Background="#14FFFFFF" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="Конфигурация" />
                                <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Text="{Binding ViewModel.ConfigStateText}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="12"
                        Foreground="#FFB900"
                        Text="{Binding ViewModel.ActionMessage}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!-- VPN Client Settings Card -->
            <ui:Card Padding="20">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="Настройки VPN-клиента" />

                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="Путь к исполняемому файлу (.exe):" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            PlaceholderText="Например: C:\Program Files\WireGuard\wireguard.exe"
                            Text="{Binding ViewModel.VpnExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            Command="{Binding ViewModel.BrowseVpnExecutableCommand}"
                            Content="Обзор..."
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>

                    <ui:ToggleSwitch
                        Margin="0,0,0,8"
                        Content="Автозапуск VPN при старте PulseGuard"
                        IsChecked="{Binding ViewModel.VpnAutoStart, Mode=TwoWay}" />

                    <ui:ToggleSwitch
                        Margin="0,0,0,8"
                        Content="Запускать VPN свёрнутым (--connect --minimized)"
                        IsChecked="{Binding ViewModel.VpnStartMinimized, Mode=TwoWay}" />

                    <ui:ToggleSwitch
                        Content="Показывать индикатор VPN в мини-виджете (оверлее)"
                        IsChecked="{Binding ViewModel.OverlayShowVpn, Mode=TwoWay}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ui:DynamicScrollViewer>
</Page>

