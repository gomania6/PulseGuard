<Window x:Class="PulseGuard.Modules.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="PulseGuard Overlay"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Border
        x:Name="RootPill"
        Padding="12,7"
        Background="{Binding ViewModel.PanelBackground}"
        BorderBrush="#33FFFFFF"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Cursor" Value="SizeAll" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ViewModel.IsPositionLocked}" Value="True">
                        <Setter Property="Cursor" Value="Arrow" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="{Binding ViewModel.LayoutOrientation}" VerticalAlignment="Center">
            <!-- CPU -->
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="{Binding ViewModel.ItemMargin}"
                Visibility="{Binding ViewModel.ShowCpu, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:SymbolIcon
                    Margin="0,0,5,0"
                    FontSize="14"
                    Foreground="#00B2FF"
                    Symbol="Pulse20"
                    Visibility="{Binding ViewModel.ShowIcons, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#A0FFFFFF"
                    Text="CPU: " />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding ViewModel.CpuText}" />
            </StackPanel>

            <!-- GPU -->
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="{Binding ViewModel.ItemMargin}"
                Visibility="{Binding ViewModel.ShowGpu, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:SymbolIcon
                    Margin="0,0,5,0"
                    FontSize="14"
                    Foreground="#00E5A0"
                    Symbol="Desktop20"
                    Visibility="{Binding ViewModel.ShowIcons, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#A0FFFFFF"
                    Text="GPU: " />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding ViewModel.GpuText}" />
            </StackPanel>

            <!-- RAM -->
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="{Binding ViewModel.ItemMargin}"
                Visibility="{Binding ViewModel.ShowRam, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:SymbolIcon
                    Margin="0,0,5,0"
                    FontSize="14"
                    Foreground="#7C5CFF"
                    Symbol="Memory16"
                    Visibility="{Binding ViewModel.ShowIcons, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#A0FFFFFF"
                    Text="ОЗУ: " />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding ViewModel.RamText}" />
            </StackPanel>

            <!-- Network -->
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="{Binding ViewModel.ItemMargin}"
                Visibility="{Binding ViewModel.ShowNetwork, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:SymbolIcon
                    Margin="0,0,5,0"
                    FontSize="14"
                    Foreground="#FFA600"
                    Symbol="ArrowSort20"
                    Visibility="{Binding ViewModel.ShowIcons, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#A0FFFFFF"
                    Text="Сеть: " />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding ViewModel.NetworkText}" />
            </StackPanel>

            <!-- VPN -->
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="{Binding ViewModel.ItemMargin}"
                Visibility="{Binding ViewModel.ShowVpn, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Ellipse
                    Width="8"
                    Height="8"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Fill="{Binding ViewModel.VpnDotBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding ViewModel.VpnText}" />
            </StackPanel>

            <!-- Input Keyboard Layout Badge -->
            <Border
                VerticalAlignment="Center"
                Margin="{Binding ViewModel.ItemMargin}"
                Padding="6,2"
                CornerRadius="6"
                BorderThickness="1"
                Visibility="{Binding ViewModel.ShowInputLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1AFFFFFF" />
                        <Setter Property="BorderBrush" Value="#26FFFFFF" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.IsInputLayoutHighlighted}" Value="True">
                                <Setter Property="Background" Value="#CC00B2FF" />
                                <Setter Property="BorderBrush" Value="#FF00E5A0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding ViewModel.InputLayoutText}" />
            </Border>

            <!-- Game Mode Session -->
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="{Binding ViewModel.ItemMargin}"
                Visibility="{Binding ViewModel.IsGameModeActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:SymbolIcon
                    Margin="0,0,4,0"
                    FontSize="14"
                    Foreground="{Binding ViewModel.SessionTimerBrush}"
                    Symbol="Games20" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{Binding ViewModel.SessionTimerBrush}"
                    Text="{Binding ViewModel.GameSessionText}" />
            </StackPanel>

            <!-- PC Session Break Reminder Timer (when not in Game Mode) -->
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="{Binding ViewModel.ItemMargin}"
                Visibility="{Binding ViewModel.ShowPcSessionTimer, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{Binding ViewModel.SessionTimerBrush}"
                    Text="{Binding ViewModel.PcSessionText}" />
            </StackPanel>

            <!-- Transient Hotkey Status (e.g., Quick RAM Clean) -->
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="{Binding ViewModel.ItemMargin}"
                Visibility="{Binding ViewModel.HasTransientStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#00E5A0"
                    Text="{Binding ViewModel.TransientStatusText}" />
            </StackPanel>

            <!-- Transient Stutter Alert (3 seconds if stutter occurred within last 10s) -->
            <Border
                VerticalAlignment="Center"
                Margin="{Binding ViewModel.ItemMargin}"
                Padding="6,2"
                Background="#44FFB900"
                BorderBrush="#FFFFB900"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding ViewModel.ShowStutterAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="#FFFFD166"
                    Text="{Binding ViewModel.StutterAlertText}" />
            </Border>

            <!-- Pinned Battery Devices -->
            <ItemsControl
                ItemsSource="{Binding ViewModel.PinnedBatteryDevices}"
                Visibility="{Binding ViewModel.HasPinnedBatteryDevices, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="{Binding ViewModel.LayoutOrientation}" VerticalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="{Binding DataContext.ViewModel.ItemMargin, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{Binding TooltipText}">
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Fill="{Binding StatusDotBrush}" />
                            <ui:SymbolIcon
                                Margin="0,0,4,0"
                                FontSize="13"
                                Foreground="{Binding TextBrush}"
                                Symbol="{Binding DeviceIcon}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{Binding TextBrush}"
                                Text="{Binding PercentText}" />
                            <TextBlock
                                Margin="3,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="#99FFFFFF"
                                Text="💤"
                                Visibility="{Binding IsSleeping, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Fallback if all metrics are disabled -->
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#CCFFFFFF"
                Text="PulseGuard"
                Visibility="{Binding ViewModel.ShowNoMetricsFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Hover action buttons -->
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="{Binding ViewModel.HoverButtonsMargin}"
                Cursor="Arrow">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, ElementName=RootPill}" Value="True" />
                                    <Condition Binding="{Binding ViewModel.ShowHoverButtons}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ui:Button
                    Margin="0,0,4,0"
                    Padding="5"
                    Appearance="Transparent"
                    Command="{Binding ViewModel.ToggleVpnCommand}"
                    ToolTip="Вкл / Выкл VPN">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.IsVpnBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <ui:SymbolIcon FontSize="13" Foreground="#00B2FF" Symbol="Shield20" />
                </ui:Button>

                <ui:Button
                    Margin="0,0,4,0"
                    Padding="5"
                    Appearance="Transparent"
                    Command="{Binding ViewModel.QuickRamCleanCommand}"
                    ToolTip="Быстрая очистка ОЗУ">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.IsRamCleaning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <ui:SymbolIcon FontSize="13" Foreground="#00E5A0" Symbol="Broom16" />
                </ui:Button>

                <ui:Button
                    Padding="5"
                    Appearance="Transparent"
                    Command="{Binding ViewModel.CloseOverlayCommand}"
                    ToolTip="Закрыть виджет">
                    <ui:SymbolIcon FontSize="13" Foreground="#CCFFFFFF" Symbol="Dismiss16" />
                </ui:Button>
            </StackPanel>
            </StackPanel>

            <!-- Discord Voice Channel & Participants -->
            <Border
                Margin="0,6,0,0"
                Padding="0,6,0,0"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,1,0,0"
                Visibility="{Binding ViewModel.ShowDiscordVoice, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#E6FFFFFF"
                        Text="{Binding ViewModel.DiscordChannelText}" />

                    <ItemsControl ItemsSource="{Binding ViewModel.DiscordParticipants}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    CornerRadius="6"
                                    Padding="4,2"
                                    Margin="0,1,0,1"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Border.Background>
                                        <SolidColorBrush Color="#00000000" />
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0" Y="0" />
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsJoining}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    From="0"
                                                                    To="1"
                                                                    Duration="0:0:0.22">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                                    From="-12"
                                                                    To="0"
                                                                    Duration="0:0:0.22">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="Background.(SolidColorBrush.Color)">
                                                                    <DiscreteColorKeyFrame KeyTime="0:0:0" Value="#4400E5A0" />
                                                                    <LinearColorKeyFrame KeyTime="0:0:0.9" Value="#2600E5A0" />
                                                                    <LinearColorKeyFrame KeyTime="0:0:1.2" Value="#00000000" />
                                                                </ColorAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLeaving}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="Background.(SolidColorBrush.Color)">
                                                                    <DiscreteColorKeyFrame KeyTime="0:0:0" Value="#44FF5C5C" />
                                                                    <LinearColorKeyFrame KeyTime="0:0:0.4" Value="#33FF5C5C" />
                                                                </ColorAnimationUsingKeyFrames>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    BeginTime="0:0:0.4"
                                                                    From="1"
                                                                    To="0"
                                                                    Duration="0:0:0.22">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseIn" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                                    BeginTime="0:0:0.4"
                                                                    From="0"
                                                                    To="10"
                                                                    Duration="0:0:0.22" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="1"
                                                                    Duration="0:0:0.1" />
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                                    To="0"
                                                                    Duration="0:0:0.1" />
                                                                <ColorAnimation
                                                                    Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                                    To="#00000000"
                                                                    Duration="0:0:0.1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Fill="{Binding IndicatorBrush}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            FontWeight="Medium"
                                            Foreground="{Binding NameBrush}"
                                            Text="{Binding DisplayName}" />
                                        <ui:SymbolIcon
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FF5C5C"
                                            Symbol="MicOff16"
                                            ToolTip="Микрофон выключен"
                                            Visibility="{Binding IsMutedOnly, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:SymbolIcon
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FF5C5C"
                                            Symbol="Headphones20"
                                            ToolTip="Звук выключен"
                                            Visibility="{Binding IsDeafened, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:SymbolIcon
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#A78BFA"
                                            Symbol="Desktop16"
                                            ToolTip="Демонстрация экрана"
                                            Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:SymbolIcon
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#38BDF8"
                                            Symbol="Video16"
                                            ToolTip="Камера включена"
                                            Visibility="{Binding IsVideoOn, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
