    <sys:String x:Key="Loc.Game.ResetTitle">Normal Mode (Reset)</sys:String>
    <sys:String x:Key="Loc.Game.ResetSub">Windows factory defaults</sys:String>
    <sys:String x:Key="Loc.Game.ResetDesc">Safely restores all registry keys from registry_backup.json, Balanced power plan, services, and resumes all suspended processes.</sys:String>
