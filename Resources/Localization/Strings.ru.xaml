    <sys:String x:Key="Loc.Set.OverlayShowTemp">Показывать температуру CPU и GPU (если доступна)</sys:String>
    <sys:String x:Key="Loc.Set.OverlayShowIcons">Показывать иконки рядом с метриками</sys:String>
