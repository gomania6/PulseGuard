    <sys:String x:Key="Loc.Set.DiscordClientIdPlaceholder">Например: 1234567890123456789</sys:String>
    <sys:String x:Key="Loc.Set.DiscordClientIdDesc">Application ID вашего приложения из Discord Developer Portal для локального RPC (rpc scope). Добавьте Redirect URI http://127.0.0.1 в настройках OAuth2.</sys:String>
    <sys:String x:Key="Loc.Set.DiscordSecret">Discord Client Secret</sys:String>
